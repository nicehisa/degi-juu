# 本番必須: 未設定だと本番の /admin は 503 で閉じます
ADMIN_PASSWORD="change-me-strong-password"

# 本番必須: 未設定だと問い合わせメールは送信されず、サーバーログへ退避されます
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 本番必須: 未設定だと問い合わせメールは送信されず、サーバーログへ退避されます
CONTACT_TO_EMAIL="admin@example.com"

# 本番必須: 未設定だとOGP・sitemap・robotsのURLが意図しないVercel URLになる場合があります
NEXT_PUBLIC_SITE_URL="https://example.com"

# 任意: 未設定時は admin がBasic認証ユーザー名になります
ADMIN_USER="admin"

# 任意: 未設定時は Resend の検証用アドレスになり、本番送信に不向きです
CONTACT_FROM_EMAIL="デジじゅう <info@example.com>"

# 任意: false にすると問い合わせ送信者への自動返信を停止します
CONTACT_AUTO_REPLY="true"

# 任意: 未設定時は送信失敗通知をWebhookへ送らず、サーバーログのみへ退避します
ALERT_WEBHOOK_URL="https://your-private-webhook.example.com/degi-juu-alert"

# 任意: 未設定時は日次の新規制度検知でGemini APIを使用できません
GEMINI_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 任意: 未設定時は静的データ src/data/municipalities.ts を使用します
GOOGLE_SHEETS_CSV_URL="https://docs.google.com/spreadsheets/d/e/xxxxxxxx/pub?output=csv"

# 任意: 未設定時はSupabaseから自治体データを取得しません
SUPABASE_URL="https://xxxxxxxx.supabase.co"

# 任意: 未設定時はSupabaseから自治体データを取得しません
SUPABASE_ANON_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 任意: 未設定時はLINE公式アカウントへの外部リンクが未設定扱いになります
NEXT_PUBLIC_LINE_OFFICIAL_URL="https://lin.ee/xxxxxxxx"
